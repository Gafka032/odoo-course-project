<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Groups -->
        <record id="module_category_courier_delivery" model="ir.module.category">
            <field name="name">Courier Delivery</field>
            <field name="description">Helps you manage your courier delivery operations</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_courier_delivery_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_courier_delivery"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will be able to manage pickup requests and delivery orders.</field>
        </record>

        <record id="group_courier_delivery_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_courier_delivery"/>
            <field name="implied_ids" eval="[(4, ref('group_courier_delivery_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">The manager will have full access to all courier delivery operations.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Record Rules -->
        <!-- Pickup Request Rules -->
        <record id="rule_pickup_request_user" model="ir.rule">
            <field name="name">Courier Pickup Request: User can see all pickup requests</field>
            <field name="model_id" ref="model_courier_pickup_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_pickup_request_manager" model="ir.rule">
            <field name="name">Courier Pickup Request: Manager can delete pickup requests</field>
            <field name="model_id" ref="model_courier_pickup_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Delivery Order Rules -->
        <record id="rule_delivery_order_user" model="ir.rule">
            <field name="name">Courier Delivery Order: User can see all delivery orders</field>
            <field name="model_id" ref="model_courier_delivery_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_delivery_order_manager" model="ir.rule">
            <field name="name">Courier Delivery Order: Manager can delete delivery orders</field>
            <field name="model_id" ref="model_courier_delivery_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Courier Schedule Rules -->
        <record id="rule_courier_schedule_user" model="ir.rule">
            <field name="name">Courier Schedule: User can see all schedules</field>
            <field name="model_id" ref="model_courier_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_courier_schedule_manager" model="ir.rule">
            <field name="name">Courier Schedule: Manager can delete schedules</field>
            <field name="model_id" ref="model_courier_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Delivery Zone Rules -->
        <record id="rule_delivery_zone_user" model="ir.rule">
            <field name="name">Delivery Zone: User can see all zones</field>
            <field name="model_id" ref="model_courier_delivery_zone"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_delivery_zone_manager" model="ir.rule">
            <field name="name">Delivery Zone: Manager can manage zones</field>
            <field name="model_id" ref="model_courier_delivery_zone"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_courier_delivery_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Multi-company Rules -->
        <record id="rule_pickup_request_company" model="ir.rule">
            <field name="name">Courier Pickup Request: Multi-company rule</field>
            <field name="model_id" ref="model_courier_pickup_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_delivery_order_company" model="ir.rule">
            <field name="name">Courier Delivery Order: Multi-company rule</field>
            <field name="model_id" ref="model_courier_delivery_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_courier_schedule_company" model="ir.rule">
            <field name="name">Courier Schedule: Multi-company rule</field>
            <field name="model_id" ref="model_courier_schedule"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_delivery_zone_company" model="ir.rule">
            <field name="name">Delivery Zone: Multi-company rule</field>
            <field name="model_id" ref="model_courier_delivery_zone"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
