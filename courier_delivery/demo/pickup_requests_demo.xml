        <record id="pickup_request_demo_draft_1" model="courier.pickup.request">
            <field name="name">PICK/2025/0001</field>
            <field name="partner_id" ref="partner_demo_sender_1"/>
            <field name="pickup_address_id" ref="partner_demo_sender_1"/>
