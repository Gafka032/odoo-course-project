<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pickup Request Tree View -->
    <record id="view_pickup_request_tree" model="ir.ui.view">
        <field name="name">courier.pickup.request.tree</field>
        <field name="model">courier.pickup.request</field>
        <field name="arch" type="xml">
            <tree string="Pickup Requests" decoration-info="state == 'draft'" decoration-success="state == 'picked'" decoration-warning="state == 'assigned'" decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pickup_address_id"/>
                <field name="request_date"/>
                <field name="pickup_date"/>
                <field name="courier_id"/>
                <field name="state"/>
                <field name="priority" widget="priority"/>
                <field name="zone_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Pickup Request Form View -->
    <record id="view_pickup_request_form" model="ir.ui.view">
        <field name="name">courier.pickup.request.form</field>
        <field name="model">courier.pickup.request</field>
        <field name="arch" type="xml">
            <form string="Pickup Request">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_assign_courier" string="Assign Courier" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_mark_picked" string="Mark as Picked" type="object" class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_mark_delivered_to_warehouse" string="Delivered to Warehouse" type="object" class="oe_highlight" invisible="state != 'picked'"/>
                    <button name="action_create_delivery" string="Create Delivery" type="object" class="oe_highlight" invisible="state != 'warehouse'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed', 'assigned')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,assigned,picked,warehouse"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_deliveries" type="object" class="oe_stat_button" icon="fa-truck" invisible="delivery_count == 0">
                            <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="pickup_address_id"/>
                            <field name="zone_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="pickup_date"/>
                            <field name="courier_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="weight"/>
                            <field name="package_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add any notes or special instructions for the courier..."/>
                        </page>
                        <page string="Delivery Orders" invisible="delivery_count == 0">
                            <field name="delivery_order_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="recipient_id"/>
                                    <field name="delivery_address_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Pickup Request Search View -->
    <record id="view_pickup_request_search" model="ir.ui.view">
        <field name="name">courier.pickup.request.search</field>
        <field name="model">courier.pickup.request</field>
        <field name="arch" type="xml">
            <search string="Search Pickup Requests">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pickup_address_id"/>
                <field name="courier_id"/>
                <field name="zone_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="Picked Up" name="picked" domain="[('state', '=', 'picked')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['2', '3'])]"/>
                <filter string="My Pickups" name="my_pickups" domain="[('courier_id', '=', uid)]"/>
                <filter string="Today's Pickups" name="today_pickups" domain="[('pickup_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('pickup_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Courier" name="group_by_courier" context="{'group_by': 'courier_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Pickup Date" name="group_by_pickup_date" context="{'group_by': 'pickup_date:day'}"/>
                    <filter string="Zone" name="group_by_zone" context="{'group_by': 'zone_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pickup Request Kanban View -->
    <record id="view_pickup_request_kanban" model="ir.ui.view">
        <field name="name">courier.pickup.request.kanban</field>
        <field name="model">courier.pickup.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pickup_date"/>
                <field name="courier_id"/>
                <field name="state"/>
                <field name="priority"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="partner_id"/>
                                </div>
                                <div class="oe_kanban_content">
                                    <div>
                                        <field name="pickup_date" widget="date"/>
                                    </div>
                                    <div t-if="record.courier_id.raw_value">
                                        <strong>Courier:</strong> <field name="courier_id"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="priority" widget="priority"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pickup Request Calendar View -->
    <record id="view_pickup_request_calendar" model="ir.ui.view">
        <field name="name">courier.pickup.request.calendar</field>
        <field name="model">courier.pickup.request</field>
        <field name="arch" type="xml">
            <calendar string="Pickup Requests" date_start="pickup_date" color="courier_id" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="courier_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Pickup Request Action -->
    <record id="action_pickup_request" model="ir.actions.act_window">
        <field name="name">Pickup Requests</field>
        <field name="res_model">courier.pickup.request</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
        <field name="search_view_id" ref="view_pickup_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new pickup request
            </p>
            <p>
                Create pickup requests for courier collection.
            </p>
        </field>
    </record>
</odoo>
