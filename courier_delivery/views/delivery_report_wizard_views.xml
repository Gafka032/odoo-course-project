<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivery Report Wizard Form View -->
    <record id="view_delivery_report_wizard_form" model="ir.ui.view">
        <field name="name">courier.delivery.report.wizard.form</field>
        <field name="model">courier.delivery.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Delivery Report">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="report_type"/>
                            <field name="include_cancelled"/>
                        </group>
                        <group>
                            <field name="courier_id" invisible="report_type == 'zone'"/>
                            <field name="zone_id" invisible="report_type == 'courier'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="View Report" type="object" class="btn-primary"/>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Delivery Report Wizard Action -->
    <record id="action_delivery_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Delivery Report</field>
        <field name="res_model">courier.delivery.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
