<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb Report for Delivery Slip -->
    <template id="report_delivery_slip_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page">
                <div class="row">
                    <div class="col-6">
                        <h2>Delivery Slip: <span t-field="doc.name"/></h2>
                        <p><strong>Tracking Reference:</strong> <span t-field="doc.tracking_ref"/></p>
                        <p><strong>Status:</strong> <span t-field="doc.state"/></p>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-12">
                                <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 45px;" alt="Logo"/>
                            </div>
                        </div>
                        <div t-if="doc.scheduled_date" class="mt-3">
                            <strong>Scheduled Date:</strong>
                            <p t-field="doc.scheduled_date" t-options='{"widget": "datetime"}'/>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-6">
                        <div class="border p-3">
                            <strong>Customer:</strong>
                            <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border p-3">
                            <strong>Recipient:</strong>
                            <div t-field="doc.recipient_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-6">
                        <div class="border p-3">
                            <strong>Delivery Address:</strong>
                            <div t-field="doc.delivery_address_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border p-3">
                            <strong>Courier:</strong>
                            <p t-if="doc.courier_id">
                                <span t-field="doc.courier_id.name"/>
                                <t t-if="doc.courier_id.vehicle_type">
                                    (<span t-field="doc.courier_id.vehicle_type"/>)
                                </t>
                            </p>
                            <p t-else="">Not assigned yet</p>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <h4>Package Information</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Package Type</th>
                                    <th>Weight (kg)</th>
                                    <th>Delivery Zone</th>
                                    <th>Delivery Fee</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span t-field="doc.package_type"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.weight"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.zone_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.delivery_fee" t-options='{"widget": "monetary", "display_currency": doc.company_id.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row mt-4" t-if="doc.notes">
                    <div class="col-12">
                        <h4>Delivery Notes</h4>
                        <p t-field="doc.notes"/>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <h4>Delivery Confirmation</h4>
                        <div class="row">
                            <div class="col-6">
                                <div class="border p-3" style="min-height: 100px;">
                                    <p>Recipient Signature:</p>
                                    <img t-if="doc.signature" t-att-src="image_data_uri(doc.signature)" style="max-height: 80px;" alt="Signature"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border p-3" style="min-height: 100px;">
                                    <p>Date and Time of Delivery:</p>
                                    <p t-if="doc.actual_delivery_date">
                                        <span t-field="doc.actual_delivery_date" t-options='{"widget": "datetime"}'/>
                                    </p>
                                    <p t-else="">Not delivered yet</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <p>Thank you for choosing our courier service!</p>
                        <p t-if="doc.company_id.phone">Contact us: <span t-field="doc.company_id.phone"/></p>
                        <p t-if="doc.company_id.email">Email: <span t-field="doc.company_id.email"/></p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_delivery_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="courier_delivery.report_delivery_slip_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- QWeb Report for Delivery Statistics -->
    <template id="report_delivery_statistics_document">
        <t t-call="web.external_layout">
            <div class="page">
                <div class="row">
                    <div class="col-12 text-center">
                        <h2>Delivery Statistics Report</h2>
                        <p>
                            <strong>Period:</strong> <span t-esc="data['date_from']" t-options='{"widget": "date"}'/> to <span t-esc="data['date_to']" t-options='{"widget": "date"}'/>
                        </p>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <h4>Summary</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-right">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_report_values(data)" t-as="line">
                                    <td>
                                        <span t-esc="line['name']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line['value']"/>
                                        <span t-if="line.get('is_percentage')">%</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div t-if="data['report_type'] == 'courier'" class="row mt-4">
                    <div class="col-12">
                        <h4>Courier Performance</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Courier</th>
                                    <th class="text-right">Deliveries</th>
                                    <th class="text-right">Success Rate</th>
                                    <th class="text-right">Avg Time (h)</th>
                                    <th class="text-right">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_courier_data(data)" t-as="courier">
                                    <td>
                                        <span t-esc="courier['name']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="courier['deliveries']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="courier['success_rate']"/>%
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="courier['avg_time']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="courier['revenue']" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div t-if="data['report_type'] == 'zone'" class="row mt-4">
                    <div class="col-12">
                        <h4>Zone Analysis</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Zone</th>
                                    <th class="text-right">Deliveries</th>
                                    <th class="text-right">Success Rate</th>
                                    <th class="text-right">Avg Time (h)</th>
                                    <th class="text-right">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_zone_data(data)" t-as="zone">
                                    <td>
                                        <span t-esc="zone['name']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="zone['deliveries']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="zone['success_rate']"/>%
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="zone['avg_time']"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="zone['revenue']" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <p>Report generated on <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/></p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_delivery_statistics">
        <t t-call="web.html_container">
            <t t-call="courier_delivery.report_delivery_statistics_document"/>
        </t>
    </template>

    <!-- Report Action Definitions -->
    <record id="action_report_delivery_slip" model="ir.actions.report">
        <field name="name">Delivery Slip</field>
        <field name="model">courier.delivery.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">courier_delivery.report_delivery_slip</field>
        <field name="report_file">courier_delivery.report_delivery_slip</field>
        <field name="print_report_name">'Delivery Slip - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_courier_delivery_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_delivery_statistics" model="ir.actions.report">
        <field name="name">Delivery Statistics</field>
        <field name="model">courier.delivery.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">courier_delivery.report_delivery_statistics</field>
        <field name="report_file">courier_delivery.report_delivery_statistics</field>
        <field name="print_report_name">'Delivery Statistics - %s' % (datetime.datetime.now().strftime('%Y-%m-%d'))</field>
        <field name="binding_model_id" ref="model_courier_delivery_report_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
